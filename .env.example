# Environment Variables Template
# Copy this file to .env and fill in your actual values

# GoHighLevel API Credentials
GHL_ACCESS_TOKEN=your_ghl_access_token_here
GHL_LOCATION_ID=your_ghl_location_id_here

# GoHighLevel sends quote texts when this switch is enabled.
AUTO_QUOTES_ENABLED=false
GOOGLE_MAPS_API_KEY=server_side_routes_api_key
GHL_QUOTE_ASSIGNEE_ID=ghl_user_for_manual_review_tasks

# A PRIVATE Vercel Blob store, plus independent random signing/review secrets.
BLOB_READ_WRITE_TOKEN=your_private_blob_store_token
QUOTE_SIGNING_SECRET=generate_a_long_random_secret
QUOTE_PHOTO_REVIEW_PASSWORD=generate_a_different_long_random_secret
QUOTE_SITE_URL=https://splendidmoving.com
CRON_SECRET=generate_a_different_long_random_cron_secret

# How to get these values:
# 1. Log into your GoHighLevel account
# 2. Go to Settings → Integrations → API Key
# 3. Copy your API Key as GHL_ACCESS_TOKEN
# 4. Your Location ID is in the URL or Settings → Business Profile
